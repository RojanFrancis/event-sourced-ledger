spring.application.name=event-sourced-ledger
server.port=8080

spring.datasource.url=jdbc:mysql://localhost:3306/ledger_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=YOUR_MYSQL_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

jwt.secret=your-very-strong-secret-key-minimum-32-chars-long
jwt.expiration=86400000

logging.level.com.ledger=DEBUG
logging.level.org.springframework.security=INFO
